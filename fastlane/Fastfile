default_platform(:android)

platform :android do
  desc "Build a signed AAB and publish it to the selected Google Play track"
  lane :release do
    required = %w[
      GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
      PLAY_TRACK
      PLAY_STATUS
    ]
    missing = required.select { |name| ENV[name].to_s.empty? }
    UI.user_error!("Missing environment variables: #{missing.join(', ')}") unless missing.empty?

    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      print_command: false
    )

    upload_to_play_store(
      package_name: "com.tiqkets.app",
      json_key_data: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      track: ENV.fetch("PLAY_TRACK"),
      release_status: ENV.fetch("PLAY_STATUS"),
      release_name: "TIQKETS #{ENV.fetch('RELEASE_VERSION')}",
      metadata_path: "fastlane/metadata/android",
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

