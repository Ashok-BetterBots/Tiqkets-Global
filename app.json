{
  "expo": {
    "name": "TIQKETS",
    "slug": "tiqkets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tiqkets",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tiqkets.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "TIQKETS uses your location to show nearby venues and confirm location-restricted queue check-ins.",
        "NSPhotoLibraryUsageDescription": "TIQKETS uses your photo library only when you choose a profile image.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#8c1867",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tiqkets.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#8c1867",
          "dark": {
            "backgroundColor": "#6a1250"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TIQKETS to access your camera to scan QR codes and join queues."
        }
      ],
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
