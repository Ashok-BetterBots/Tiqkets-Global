# ============================================================
# TIQKETS — Production Environment Variables
# Copy this file to .env and fill in your values before deploy
# ============================================================

# --- DATABASE (Required) ---

# PostgreSQL connection string.
# If using the bundled docker-compose.yml postgres, set only DB_PASSWORD below.
# If using an external DB (RDS, Lightsail DB, Supabase, etc.) set the full URL.
DATABASE_URL=postgresql://tiqkets:YOUR_DB_PASSWORD@localhost:5432/tiqkets

# Password for the bundled postgres container (docker-compose.yml only)
DB_PASSWORD=changeme_strong_password

# --- DOMAIN (Required) ---

# Your server's public domain — without protocol, without trailing slash.
# Examples: myapp.com  or  api.myapp.com  or  1.2.3.4:5000
APP_DOMAIN=yourdomain.com
EXPO_PUBLIC_DOMAIN=yourdomain.com

# Comma-separated allowed CORS origins (with protocol)
ALLOWED_ORIGINS=https://yourdomain.com

# --- SECURITY (Required in production) ---

# Random 64-character hex string — used to sign org session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORG_SESSION_SECRET=replace_with_64_char_hex_secret

# Token that grants access to the Super Admin portal (/superadmin).
# Use a long random string — this IS the password.
SUPER_ADMIN_PORTAL_TOKEN=replace_with_super_admin_token

# Super Admin email / password for the /superadmin dashboard login.
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=replace_with_super_admin_password

# --- SERVER ---
PORT=5000

# --- EMAIL (Optional — needed for OTP verification emails) ---

# ZeptoMail SMTP "Send Mail Token" (acts as the SMTP password)
ZEPTOMAIL_SMTP_PASSWORD=

# "From" email address for all outgoing mail
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com

# Support email shown in emails
SUPPORT_EMAIL=support@yourdomain.com

# --- WHATSAPP (Optional) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- RAZORPAY PAYMENTS (Optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
