# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# When using docker-compose.yml (bundled DB) this is set automatically.
# When using docker-compose.external-db.yml point this at your own Postgres.
DATABASE_URL=postgresql://tiqkets:changeme_strong_password@db:5432/tiqkets

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Super-admin credentials (used to log in to /super-admin).
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change_me_strong_password

# Public domain / hostname the server is reachable at (no trailing slash).
# Used for CORS, session cookies, and Expo manifest URLs.
# Examples:
#   APP_DOMAIN=yourdomain.com
#   APP_DOMAIN=192.168.1.100:5000   (LAN testing)
APP_DOMAIN=yourdomain.com

# ─── Mobile App ───────────────────────────────────────────────────────────────
# The Expo mobile app bundle must be built with this env var set to your
# server's public hostname (matching APP_DOMAIN above).
# This is a BUILD-TIME variable — you must rebuild the app after changing it.
#
#   EXPO_PUBLIC_DOMAIN=yourdomain.com
#
# Build command:
#   npx eas build --platform android   # or ios
# Or for a local development build:
#   EXPO_PUBLIC_DOMAIN=yourdomain.com npx expo start

# ─── Optional: Email (Zeptomail SMTP) ─────────────────────────────────────────
# If not set, OTP emails are skipped (OTPs still print to server logs in
# development, which lets you complete registration without email).
# ZEPTOMAIL_SMTP_PASSWORD=your_zeptomail_smtp_password

# ─── Optional: WhatsApp Business API ──────────────────────────────────────────
# Required for WhatsApp queue notifications. Obtain from Meta Business Manager.
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ─── Optional: Push Notifications ────────────────────────────────────────────
# Expo push notification credentials (only needed if using push alerts on mobile).
# EXPO_ACCESS_TOKEN=your_expo_access_token

# ─── Optional: Object Storage (Replit) ───────────────────────────────────────
# Only needed when running on Replit. Self-hosted deployments use local disk
# (server/uploads/) for file uploads automatically.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=

# ─── Optional: Payments (Razorpay) ────────────────────────────────────────────
# Required only if you want to accept online payments.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Runtime (set automatically by docker-compose) ────────────────────────────
NODE_ENV=production
PORT=5000
