# ============================================
# TIQKETS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- Required ---

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tiqkets

# Your server's domain (without protocol)
# For local dev: localhost:5000
# For production: yourdomain.com or api.yourdomain.com
APP_DOMAIN=yourdomain.com

# Server port (default: 5000)
PORT=5000

# --- Expo / Mobile App ---

# Domain the mobile app connects to (same as APP_DOMAIN for production)
# For local dev with Expo: localhost:5000
EXPO_PUBLIC_DOMAIN=yourdomain.com

# --- Optional: CORS ---

# Comma-separated list of allowed origins (full URLs with protocol)
# Example: https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# --- Optional: WhatsApp Business API ---

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# --- Optional: Razorpay Payments ---

RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
